# Every trading parameter has a default in app/core/config.py — those defaults
# are what the backtest measured. Only set a value here if you deliberately want
# to override one, otherwise leave this file as-is.

# LLM — required. The veto agent calls Anthropic and searches with Tavily.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Database
# Local dev: a file on disk, created on first run.
DATABASE_URL=sqlite:///swing_bot.db
# Deployed: hosted Postgres, so the data outlives the server it runs on.
# Needs psycopg (already in requirements) and the +psycopg driver in the URL.
# DATABASE_URL=postgresql+psycopg://user:pass@host.neon.tech:5432/dbname?sslmode=require

# Example overrides (commented out — uncomment only to deviate from the
# backtested configuration)
# STARTING_CAPITAL=200000
# MAX_POSITIONS=5
# RULES_CONFIDENCE_THRESHOLD=65
# VETO_MODE=shadow    # off | shadow | acting — shadow records a verdict without blocking
